    {
        "id": "atmo.prep",
        "type": "function",
        "z": "atmo.tab",
        "name": "dedupe + cache or geocode",
        "func": "// The sensor updates its name before its location attribute, so the pair that\n// arrives on a state change can be a new view against the previous view's\n// place. The delay ahead of this node and the fresh read feeding it are what\n// make the pair trustworthy; nothing here trusts the original event.\nconst ent = msg.data || {};\nconst view = String(ent.state == null ? '' : ent.state).trim();\nconst attrs = ent.attributes || {};\nconst location = String(attrs.location == null ? '' : attrs.location).trim();\n\nif (!view || view === 'unknown' || view === 'unavailable') {\n    node.status({ fill: 'grey', shape: 'ring', text: 'no view reported' });\n    return null;\n}\n\n// Several changes in quick succession queue several evaluations that all\n// re-read the same settled value. Only the first of them is worth anything.\nconst key = view + '|' + location;\nif (flow.get('lastView') === key) { return null; }\nflow.set('lastView', key);\n\nmsg.view = view;\nmsg.location = location;\nmsg.thumb = attrs.image_url || null;\n\nif (!location) {\n    msg.country = null;\n    return [null, msg];\n}\n\nconst cache = flow.get('geo') || {};\nif (Object.prototype.hasOwnProperty.call(cache, location)) {\n    msg.country = cache[location];\n    return [null, msg];\n}\n\n// Nominatim requires a real User-Agent and asks for no more than one call a\n// second. Every place is looked up once and remembered, so with 48 advances a\n// day and a warm cache this is rare.\nmsg.url = 'https://nominatim.openstreetmap.org/search'\n        + '?format=json&limit=1&addressdetails=1&accept-language=en&q='\n        + encodeURIComponent(location);\nmsg.headers = { 'User-Agent': 'bowman-mtn-node-red/1.0 (home automation)' };\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 220,
        "y": 660,
        "wires": [
            [
                "atmo.geo"
            ],
            [
                "atmo.decide"
            ]
        ]
    },
    {
        "id": "atmo.geo",
        "type": "http request",
        "z": "atmo.tab",
        "name": "Nominatim",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 460,
        "y": 620,
        "wires": [
            [
                "atmo.decide"
            ]
        ]
    },
    {
        "id": "atmo.decide",
        "type": "function",
        "z": "atmo.tab",
        "name": "blocked?",
        "func": "// Reached either straight from the cache or from the geocoder.\nif (msg.country === undefined) {\n    let cc = null;\n    const hit = Array.isArray(msg.payload) ? msg.payload[0] : null;\n    if (hit && hit.address && hit.address.country_code) {\n        cc = String(hit.address.country_code).toLowerCase();\n    }\n    msg.country = cc;\n    const cache = flow.get('geo') || {};\n    // Misses are cached too, so a place that cannot be resolved is not looked\n    // up again every half hour.\n    cache[msg.location] = cc;\n    flow.set('geo', cache);\n}\n\nconst bl = flow.get('blocklist') || {};\nconst lower = (a) => (Array.isArray(a) ? a : []).map((s) => String(s).toLowerCase());\nconst always = lower(bl.always);\nconst countries = lower(bl.countries);\nconst views = Array.isArray(bl.views) ? bl.views : [];\nconst locations = Array.isArray(bl.locations) ? bl.locations : [];\nconst cc = msg.country ? String(msg.country).toLowerCase() : null;\n\nlet blocked = false;\nlet reason;\n\nif (cc && always.indexOf(cc) >= 0) {\n    // Always-allow wins over every other rule. Japan is not on the country\n    // blocklist to begin with, but because location lags the name a Japanese\n    // view can momentarily read against the previous view's place. This makes\n    // blocking it impossible rather than merely unlikely.\n    reason = 'always allowed (' + cc + ')';\n} else if (cc && countries.indexOf(cc) >= 0) {\n    blocked = true;\n    reason = 'country ' + cc;\n} else if (views.indexOf(msg.view) >= 0) {\n    blocked = true;\n    reason = 'view on blocklist';\n} else if (locations.indexOf(msg.location) >= 0) {\n    blocked = true;\n    reason = 'location on blocklist';\n} else if (!cc) {\n    // Fail open. Anything uncertain is shown, never skipped: the cost of\n    // wrongly showing a view is one button press, the cost of wrongly\n    // skipping is silently censoring places worth seeing.\n    reason = msg.location ? 'no country for ' + msg.location : 'no location given';\n} else {\n    reason = 'allowed (' + cc + ')';\n}\n\nmsg.blocked = blocked;\nmsg.reason = reason;\n\nconst skips = Number(flow.get('skips') || 0);\nif (blocked) {\n    // A run of blocked views must not become a loop hammering the device.\n    if (skips >= 5) {\n        node.warn('five blocked views in a row, showing this one instead of pressing again: '\n                  + msg.view + ' (' + reason + ')');\n        msg.blocked = false;\n        msg.reason = 'loop guard held, would have skipped: ' + reason;\n        flow.set('skips', 0);\n        return [null, msg];\n    }\n    flow.set('skips', skips + 1);\n    return [msg, null];\n}\nflow.set('skips', 0);\nreturn [null, msg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 680,
        "y": 660,
        "wires": [
            [
                "atmo.press",
                "atmo.log"
            ],
            [
                "atmo.log"
            ]
        ]
    },
    {
        "id": "atmo.log",
        "type": "function",
        "z": "atmo.tab",
        "name": "last 100 views",
        "func": "// Memory only and capped, so it cannot grow into a leak. Newest first. This is\n// what \"too city like\" and \"beachy\" get read out of: after a few days, read\n// flow context 'views' and move the offenders into the blocklist.\nconst store = flow.get('views') || [];\nstore.unshift({\n    at: new Date().toISOString(),\n    view: msg.view || null,\n    location: msg.location || null,\n    country: msg.country || null,\n    thumb: msg.thumb || null,\n    skipped: !!msg.blocked,\n    reason: msg.reason || null\n});\nflow.set('views', store.slice(0, 100));\nnode.status({\n    fill: msg.blocked ? 'yellow' : 'green',\n    shape: 'dot',\n    text: (msg.blocked ? 'skipped ' : 'showing ') + (msg.view || '?')\n});\nmsg.summary = (msg.blocked ? 'skipped ' : 'showing ')\n            + (msg.view || '?') + ' | ' + (msg.location || 'no location')\n            + ' | ' + (msg.country || '--') + ' | ' + (msg.reason || '');\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 900,
        "y": 720,
        "wires": [
            [
                "atmo.debug"
            ]
        ]
    },
